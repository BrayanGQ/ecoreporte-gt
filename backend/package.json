{
  "name": "ecoreporte-backend",
  "version": "1.0.3",
  "description": "API REST de EcoReporte GT — plataforma de vertederos clandestinos",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node src/seed.js",
    "demo": "node src/demo.js",
    "bd:esquema": "node scripts/cargar-esquema.js",
    "test:bd": "node scripts/preparar-bd-pruebas.js",
    "test": "jest --runInBand",
    "test:cobertura": "jest --runInBand --ci --coverage --coverageDirectory=../qa-salida/cobertura --coverageReporters=text --coverageReporters=json-summary --json --outputFile=../qa-salida/resultados.json",
    "calidad:compuerta": "node ../qa/umbral-cobertura.js ../qa-salida/cobertura/coverage-summary.json",
    "lint": "eslint .",
    "medir": "node scripts/medir-rendimiento.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests",
      "<rootDir>/src"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup/entorno.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup/mock-correo.js",
      "<rootDir>/tests/setup/cerrar-pool.js"
    ],
    "testTimeout": 30000,
    "verbose": true,
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
