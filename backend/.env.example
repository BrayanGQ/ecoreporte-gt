# Copiá este archivo como .env y ajustá los valores según tu instalación local.
# .env contiene credenciales: está en .gitignore y nunca debe subirse al repositorio.

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecoreporte
DB_USER=postgres
DB_PASSWORD=tu_contraseña_de_postgres

# --- Servidor ---
PORT=3000

# --- Autenticación JWT ---
# Cadena larga y aleatoria para firmar los tokens. Cambiala en cada instalación.
# Por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esta_clave_por_una_cadena_larga_y_aleatoria
# Duración de la sesión (formato de jsonwebtoken: 8h, 30m, 1d...).
JWT_EXPIRES_IN=8h
