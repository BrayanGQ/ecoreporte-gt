# Copiá este archivo como .env y ajustá los valores según tu instalación local.
# .env contiene credenciales: está en .gitignore y nunca debe subirse al repositorio.

# --- Entorno ---
# En el servidor de producción (Render) poné NODE_ENV=production. En local podés omitirla.
# NODE_ENV=production

# --- Base de datos en la nube (Neon) ---
# Cadena de conexión que da Neon (Dashboard → Connection string). Si está definida, el backend
# la usa con SSL e ignora las variables DB_* de abajo. Dejala comentada para trabajar en local.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST/BASE?sslmode=require
# DATABASE_URL=

# --- Base de datos PostgreSQL local (si no se usa DATABASE_URL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecoreporte
DB_USER=postgres
DB_PASSWORD=tu_contraseña_de_postgres

# --- Servidor ---
PORT=3000

# --- Autenticación JWT ---
# Cadena larga y aleatoria para firmar los tokens. Cambiala en cada instalación.
# Por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esta_clave_por_una_cadena_larga_y_aleatoria
# Duración de la sesión (formato de jsonwebtoken: 8h, 30m, 1d...).
JWT_EXPIRES_IN=8h

# --- Usuarios de demostración ---
# Contraseña que asignan npm run seed (usuarios demo base) y npm run demo (cuentas de la
# demostración). Si no se define, se usa password123. En producción definí una propia
# (mínimo 6 caracteres) para que las cuentas demo no queden con una contraseña pública.
# Las pruebas automatizadas no la usan: la base de pruebas siempre usa password123.
# DEMO_PASSWORD=
